# Database
DB_USER=postgres
DB_PASSWORD=0000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SARAI_DB

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# SMTP (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=ton.email@gmail.com
SMTP_PASSWORD=ton-app-password-gmail

# Admin address that receives new-user/new-project alerts (defaults to SMTP_EMAIL if unset)
ADMIN_EMAIL=admin@example.com

# Frontend URL
FRONTEND_URL=http://localhost:5500

# Ollama (chatbot + semantic search)
# In production, the backend runs in a Docker container: "localhost" would
# point at the container itself, not the host where Ollama actually runs.
# Use host.docker.internal instead (see deploy/docker-compose.prod.yml).
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
