# Deployment manifest — rewritten automatically by the update-manifest job
# in .github/workflows/ci-cd.yml after every successful build on Main.
# Do not hand-edit except to force a rollback (set IMAGE_TAG to a previous
# short SHA, then re-run `docker compose ... up -d` on the deploy host).
BACKEND_IMAGE=fatmahajjem/sarai-backend
FRONTEND_IMAGE=fatmahajjem/sarai-frontend
IMAGE_TAG=latest
DEPLOYED_COMMIT=
DEPLOYED_AT=
